# New World Kids Platform - Environment Variable TEMPLATE
# Never commit live credentials. Fill values through a secure local/runtime secret store.

NODE_ENV=development

# Deployment metadata (non-secret)
VERCEL_PROJECT_ID=
VERCEL_ORG_ID=

# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Opportunity intake email
RESEND_API_KEY=
OPPORTUNITY_EMAIL_FROM=
OPPORTUNITY_EMAIL_TO=info@nwkids.org

# Web app
APP_PUBLIC_URL=http://localhost:3000
NEXT_PUBLIC_STRAPI_URL=http://localhost:1337
NEXT_PUBLIC_SOLANA_NETWORK=devnet
NEXT_PUBLIC_FEATURE_FLAGS=ENABLE_NEW_BRANDING
NEXT_PUBLIC_HLS_URL=
NEXT_PUBLIC_STREAM_SERVICE_URL=
BLOCKCHAIN_SERVICE_URL=

# Strapi
STRAPI_URL=http://localhost:1337
STRAPI_REST_READONLY_API_KEY=
STRAPI_TOKEN=
STRAPI_ADMIN_JWT=

# Database
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_NAME=newworldkids
DATABASE_USERNAME=postgres
DATABASE_PASSWORD=
DATABASE_SSL=false
DATABASE_URL=

# Optional external services
HELIUS_RPC_URL=
NFT_MINT_WALLET_PRIVATE_KEY=
PINATA_API_KEY=
PINATA_SECRET_KEY=
REDIS_URL=
OPENROUTER_API_KEY=
SENTRY_DSN=
SENTRY_AUTH_TOKEN=
AWS_ACCESS_KEY_ID=
AWS_ACCESS_SECRET=
